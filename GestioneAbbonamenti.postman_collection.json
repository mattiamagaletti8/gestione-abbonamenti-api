{
  "info": {
    "name": "Gestione Abbonamenti - Mattia",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8085"
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "abbonamentoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Crea cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/clienti",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Cliente Postman\",\n  \"email\": \"{{emailNuova}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"clienteId\", pm.response.json().id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"emailNuova\", \"postman-\" + Date.now() + \"@example.com\");"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Crea abbonamento",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/abbonamenti",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"piano\": \"Premium\",\n  \"prezzoMensile\": 19.9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"abbonamentoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Elenco clienti",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/clienti"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Cerca abbonamento",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/abbonamenti/{{abbonamentoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - Solo attivi",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/abbonamenti?attivo=true"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Totale mensile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/abbonamenti/totale-mensile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "7 - Disattiva",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/abbonamenti/{{abbonamentoId}}/disattiva"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "8 - Prezzo negativo - errore atteso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/abbonamenti",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": 1,\n  \"piano\": \"Errato\",\n  \"prezzoMensile\": -1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "9 - ID inesistente - errore atteso",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/abbonamenti/999999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
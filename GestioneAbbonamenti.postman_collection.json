{
  "info": {
    "name": "Gestione Abbonamenti - Mattia",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8085"
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "abbonamentoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Crea cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/clienti",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Cliente Postman\",\n  \"email\": \"cliente.postman@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2 - Crea abbonamento",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/abbonamenti",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"piano\": \"Premium\",\n  \"prezzoMensile\": 19.9\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3 - Elenco clienti",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/clienti"
      }
    },
    {
      "name": "4 - Cerca abbonamento",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/abbonamenti/{{abbonamentoId}}"
      }
    },
    {
      "name": "5 - Solo attivi",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/abbonamenti?attivo=true"
      }
    },
    {
      "name": "6 - Totale mensile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/abbonamenti/totale-mensile"
      }
    },
    {
      "name": "7 - Disattiva",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/abbonamenti/{{abbonamentoId}}/disattiva"
      }
    }
  ]
}
